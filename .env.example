# Curlset — environment template. Copy to .env and edit.
# Never commit a real .env or any key.

# Server
ENVIRONMENT=development
API_HOST=127.0.0.1
API_PORT=8000
WEB_PORT=5173
SECRET_KEY=change-this-to-a-random-string-for-any-non-local-deployment

# Database (SQLite is the supported default; PostgreSQL is not wired yet)
DATABASE_URL=sqlite:///./data/dataset_platform.db

# Storage (only 'local' is implemented)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/storage

# Jobs run in-process; there is no external worker
WORKER_MODE=inline

# Privacy boundary: local_only blocks outbound calls; allow_external permits explicitly
# configured providers. Manual annotation/validation/export work with no provider.
PRIVACY_MODE=local_only

# Deterministic simulated providers (offline demos/tests). Keep false for real data runs.
ALLOW_SIMULATED_PROVIDERS=false

# Paid image generation providers (OpenAI gpt-image-2 / Meta muse-image-1.0).
# Off by default: each call bills per image. Hard cap is 25 images per run.
ENABLE_LIVE_IMAGE_PROVIDERS=false

# Provider credentials (only needed for live calls; never commit keys)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_SAM_MODEL=sam-3.1

# Sandbox and ingestion limits
MAX_UPLOAD_SIZE_BYTES=104857600        # 100 MB per file
MAX_ARCHIVE_ENTRY_COUNT=1000            # entries per ZIP
MAX_DECOMPRESSED_SIZE_BYTES=524288000  # 500 MB total after decompression
MAX_PARSING_TIMEOUT_SECONDS=60
