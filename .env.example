# AI Dataset Engineering Platform - Environment Configuration Baseline
# Copy this file to .env and adjust as needed for your local or production environment.

# Server Configuration
ENVIRONMENT=development
API_HOST=127.0.0.1
API_PORT=8000
WEB_PORT=5173
SECRET_KEY=change-this-in-production-to-a-secure-random-string

# Database
# SQLite is used for zero-dependency local development and testing.
# PostgreSQL can be configured for production/hosted setups:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dataset_platform
DATABASE_URL=sqlite:///./data/dataset_platform.db

# Storage Configuration
# Options: 'local' (filesystem) or 's3' (AWS S3 / MinIO)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/storage

# Background Job Worker
# Options: 'inline' (synchronous execution for tests/simple dev) or 'background'
WORKER_MODE=inline

# Privacy & Security Boundary
# 'local_only': Prevents outbound calls to remote AI APIs; only local runtimes (Ollama/vLLM) and FakeProvider allowed.
# 'allow_external': Allows explicit, user-initiated external model API calls.
PRIVACY_MODE=local_only

# Safe Ingestion Limits
MAX_UPLOAD_SIZE_BYTES=104857600       # 100 MB max per file upload
MAX_ARCHIVE_ENTRY_COUNT=1000          # Max files inside a ZIP archive
MAX_DECOMPRESSED_SIZE_BYTES=524288000 # 500 MB max decompressed archive size
MAX_PARSING_TIMEOUT_SECONDS=60        # Safe parser timeout
