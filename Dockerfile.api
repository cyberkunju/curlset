# Multi-modal AI Dataset Engineering Platform - Backend Dockerfile
FROM python:3.13-slim

WORKDIR /app

# Install system dependencies for media processing and health checks
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libmagic1 \
    && rm -rf /var/lib/apt/lists/*

# Install python dependencies first for efficient layer caching
COPY pyproject.toml README.md LICENSE /app/
COPY packages /app/packages
COPY services /app/services
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir .

COPY examples /app/examples
COPY scripts /app/scripts

# Create persistent storage and data directories
RUN mkdir -p /app/data/storage

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    STORAGE_BACKEND=local \
    LOCAL_STORAGE_DIR=/app/data/storage \
    API_HOST=0.0.0.0 \
    API_PORT=8000

EXPOSE 8000

# Container healthcheck against /api/v1/health
HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/api/v1/health || exit 1

CMD ["uvicorn", "services.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
